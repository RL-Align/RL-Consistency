{
  "schema_version": "rlkernel.repro.profile.v1",
  "name": "local-mi300x-qwen3-8b",
  "requirements": {"backend": "rocm", "python": "3.12"},
  "paths": {
    "workspace": "/workspace",
    "rl_kernel_root": "/workspace/RL-Kernel-consistency",
    "vime_root": "/workspace/vime",
    "megatron_root": "/workspace/Megatron-LM",
    "vllm_root": "/workspace/vllm",
    "python": "/opt/venv/bin/python",
    "model_root": "/app/model/Qwen3-8B",
    "ref_load": "/app/model/Qwen3-8B_torch_dist",
    "prompt_data": "/app/model/dapo-math-17k/dapo-math-17k.jsonl"
  },
  "defaults": {
    "backend": "rocm", "mode": "consistency",
    "tp": 4, "cp": 2, "rollout-tp": 4, "rollout-cp": 1,
    "temperature": 1.0, "top-p": 1.0, "top-k": -1,
    "samples-per-prompt": 8, "global-batch-size": 8, "rollout-batch-size": 1,
    "max-response-length": 7168, "max-tokens-per-gpu": 4096,
    "vllm-gpu-memory-utilization": 0.4,
    "seed": 1234, "rollout-seed": 1234, "kl-coef": 0.001,
    "ray-port": 8090, "ray-dashboard-port": 48025
  }
}
